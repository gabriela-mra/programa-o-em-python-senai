# n1 = int(input('numero 1: '))
# n2 = int(input('numero 2: '))
# n3 = int(input('numero 3: '))

if n1 == n2 == n3:
    print('triangulo equilátero')
elif (n1 == n2 and n2 != n3) or \
     (n1 == n3 and n1 != n2) or \
     (n2 == n3 and n1 != n2):
