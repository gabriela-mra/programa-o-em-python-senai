import customtkinter as ctk
import sqlite3
import tkinter as tk
from tkinter import messagebox
from tkinter import ttk

ctk.set_appearance_mode('Dark')
ctk.set_default_color_theme('blue')


criando = sqlite3.connect('Agencia de Marketing.db')
cursor = criando.cursor()

cursor.execute('''
CREATE TABLE IF NOT EXISTS dados(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT,
    idade INTEGER,
    email TEXT,
    endereço TEXT,
    trabalho TEXT,
    graduação TEXT
)
''')

criando.commit()


def criar_dados():

    nome = nome_input.get()
    idade = idade_input.get()
    email = email_input.get()
    endereço = endereço_input.get()
    trabalho = trabalho_input.get()
    graduação = graduação_input.get()

    if nome and idade and email:

        cursor.execute('''
        INSERT INTO dados(nome, idade, email, endereço, trabalho, graduação)
        VALUES (?, ?, ?, ?, ?, ?)
        ''', (nome, idade, email, endereço, trabalho, graduação))

        criando.commit()

        messagebox.showinfo('', 'DADOS INSERIDOS COM SUCESSO')

        limpar_campos()
        listar_heads()

    else:
        messagebox.showwarning('', 'PREENCHA NOME, IDADE E E-MAIL')


def listar_heads():

    for row in tabela.get_children():
        tabela.delete(row)

    cursor.execute('SELECT * FROM dados')

    heads = cursor.fetchall()

    for head in heads:
        tabela.insert('', 'end', values=head)


def deletar_dados():

    selecao = tabela.selection()

    if selecao:

        dados_selecionados = tabela.item(selecao)

        id_dado = dados_selecionados['values'][0]

        cursor.execute(
            'DELETE FROM dados WHERE id = ?',
            (id_dado,)
        )

        criando.commit()

        messagebox.showinfo('', 'DADO DELETADO')

        listar_heads()
        limpar_campos()

    else:
        messagebox.showwarning('', 'SELECIONE UM DADO')


def atualizar_dados():

    selecao = tabela.selection()

    if selecao:

        dados_selecionados = tabela.item(selecao)

        id_dado = dados_selecionados['values'][0]

        nome = nome_input.get()
        idade = idade_input.get()
        email = email_input.get()
        endereço = endereço_input.get()
        trabalho = trabalho_input.get()
        graduação = graduação_input.get()

        if nome and idade and email:

            cursor.execute('''
            UPDATE dados
            SET nome = ?,
                idade = ?,
                email = ?,
                endereço = ?,
                trabalho = ?,
                graduação = ?
            WHERE id = ?
            ''', (
                nome,
                idade,
                email,
                endereço,
                trabalho,
                graduação,
                id_dado
            ))

            criando.commit()

            messagebox.showinfo('', 'DADOS ATUALIZADOS')

            limpar_campos()
            listar_heads()

        else:
            messagebox.showwarning('', 'PREENCHA NOME, IDADE E E-MAIL')

    else:
        messagebox.showwarning('', 'SELECIONE UM DADO')


def selecionar_dado(event):

    selecao = tabela.selection()

    if selecao:

        dados = tabela.item(selecao)['values']

        nome_input.delete(0, tk.END)
        nome_input.insert(0, dados[1])

        idade_input.delete(0, tk.END)
        idade_input.insert(0, dados[2])

        email_input.delete(0, tk.END)
        email_input.insert(0, dados[3])

        endereço_input.delete(0, tk.END)
        endereço_input.insert(0, dados[4])

        trabalho_input.delete(0, tk.END)
        trabalho_input.insert(0, dados[5])

        graduação_input.delete(0, tk.END)
        graduação_input.insert(0, dados[6])


def limpar_campos():

    nome_input.delete(0, tk.END)
    idade_input.delete(0, tk.END)
    email_input.delete(0, tk.END)
    endereço_input.delete(0, tk.END)
    trabalho_input.delete(0, tk.END)
    graduação_input.delete(0, tk.END)


